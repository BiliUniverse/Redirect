name: "{{@package 'displayName'}} β"
desc: |-
  {{#each (split (@package 'description') "\n")}}
  {{{this}}}
  {{/each}}
openUrl: "{{@package 'openUrl'}}"
author: |-
  {{#each (@package 'contributors')}}
  {{this}}
  {{/each}}
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
category: "{{@package 'organizationName'}}"
date: "{{now "yyyy-MM-dd HH:mm:ss"}}"
version: "{{@package 'version'}}"

http:
  force-http-engine:
    - "*.bilivideo.com:80"
    - "*.mcdn.bilivideo.cn:80"
    - "upos-*-mirrorakam.akamaized.net:80"
    - "*:4480"
    - "*:8000"
    - "*:9102"
  mitm:
    - "biliverse.github.io"
    - "app.bilibili.com"
    - "*.mcdn.bilivideo.cn"
    - "*.mcdn.bilivideo.cn:4483"
    - "*.mcdn.bilivideo.cn:8082"
    - "upos-sz-mirror*.bilivideo.com"
    - "cn-hk-eq-*.bilivideo.com"
    - "upos-*-mirrorakam.akamaized.net"
    - "upos-sz-mirror*.bilivideo.com:4483"
    - "cn-hk-eq-*.bilivideo.com:4483"
    - "upos-*-mirrorakam.akamaized.net:4483"
  url-rewrite:
    - ^http:\/\/upos-sz-mirror[a-z0-9-]*ov\.bilivideo\.com(?::80)?\/upgcxcode\/ http://\{{{Host.OverseaVideo}}}/upgcxcode/ header
    - ^http:\/\/cn-hk-eq-[a-z0-9-]+\.bilivideo\.com(?::80)?\/upgcxcode\/ http://\{{{Host.OverseaVideo}}}/upgcxcode/ header
    - ^http:\/\/upos-hz-mirrorakam\.akamaized\.net(?::80)?\/upgcxcode\/ http://\{{{Host.OverseaVideo}}}/upgcxcode/ header
    - ^http:\/\/upos-sz-mirrorakam\.akamaized\.net(?::80)?\/upgcxcode\/ http://\{{{Host.OverseaVideo}}}/upgcxcode/ header
    - ^http:\/\/upos-sz-mirror[a-z0-9-]*bstar1\.bilivideo\.com(?::80)?\/upgcxcode\/ http://\{{{Host.BStar}}}/upgcxcode/ header
    - ^http:\/\/upos-bstar1-mirrorakam\.akamaized\.net(?::80)?\/upgcxcode\/ http://\{{{Host.BStar}}}/upgcxcode/ header
    - ^https:\/\/upos-sz-mirror[a-z0-9-]*ov\.bilivideo\.com(?::(?:443|4483))?\/upgcxcode\/ https://\{{{Host.OverseaVideo}}}/upgcxcode/ header
    - ^https:\/\/cn-hk-eq-[a-z0-9-]+\.bilivideo\.com(?::(?:443|4483))?\/upgcxcode\/ https://\{{{Host.OverseaVideo}}}/upgcxcode/ header
    - ^https:\/\/upos-hz-mirrorakam\.akamaized\.net(?::(?:443|4483))?\/upgcxcode\/ https://\{{{Host.OverseaVideo}}}/upgcxcode/ header
    - ^https:\/\/upos-sz-mirrorakam\.akamaized\.net(?::(?:443|4483))?\/upgcxcode\/ https://\{{{Host.OverseaVideo}}}/upgcxcode/ header
    - ^https:\/\/upos-sz-mirror[a-z0-9-]*bstar1\.bilivideo\.com(?::(?:443|4483))?\/upgcxcode\/ https://\{{{Host.BStar}}}/upgcxcode/ header
    - ^https:\/\/upos-bstar1-mirrorakam\.akamaized\.net(?::(?:443|4483))?\/upgcxcode\/ https://\{{{Host.BStar}}}/upgcxcode/ header
  script:
    - match: ^https:\/\/biliverse\.github\.io\/settings\/api\/Redirect(?:\?.*)?$
      name: "📺 BiliBili.Redirect.request"
      type: request
      require-body: true
    - match: ^https?:\/\/.+\.bilivideo\.com(?::(?:80|443|4483))?\/upgcxcode\/
      name: "📺 BiliBili.Redirect.request"
      type: request
    - match: ^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(?::(?:8000|8082))?\/v1\/resource\/
      name: "📺 BiliBili.Redirect.request"
      type: request
      argument:
    - match: ^https?:\/\/[adbcefxy0-9]+\.mcdn\.bilivideo\.cn(?::(?:4483|9102))?\/upgcxcode\/
      name: "📺 BiliBili.Redirect.request"
      type: request
      argument:
    - match: ^https?:\/\/(.+):4480\/upgcxcode\/
      name: "📺 BiliBili.Redirect.request"
      type: request
      argument:
    - match: ^https?:\/\/upos-hz-mirrorakam\.akamaized\.net(?::(?:80|443|4483))?\/upgcxcode\/
      name: "📺 BiliBili.Redirect.request"
      type: request
      argument:
    - match: ^https?:\/\/upos-sz-mirrorakam\.akamaized\.net(?::(?:80|443|4483))?\/upgcxcode\/
      name: "📺 BiliBili.Redirect.request"
      type: request
      argument:
    - match: ^https?:\/\/upos-bstar1-mirrorakam\.akamaized\.net(?::(?:80|443|4483))?\/upgcxcode\/
      name: "📺 BiliBili.Redirect.request"
      type: request
      argument:
script-providers:
  "📺 BiliBili.Redirect.request":
    url: https://gist.githubusercontent.com/VirgilClyne/0c193c4ff4b930d765b1ca4b406ec1b9/raw/request.dev.bundle.js
    interval: 86400
