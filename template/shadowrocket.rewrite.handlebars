[URL Rewrite]
^http:\/\/((?:(?:upos-(?:hz|sz|bstar1)-mirrorakam\.akamaized\.net|upos-sz-mirror[a-z0-9-]*(?:ov|bstar1)\.bilivideo\.com|cn-hk-eq-[a-z0-9-]+\.bilivideo\.com)(?::\d+)?|[^/]+:4480|[adbcefxy0-9]+\.mcdn\.bilivideo\.cn:(?:4483|9102)))\/(upgcxcode\/.*)$ https:\/\/\{{{endpoint}}}\/http\/$1\/$2 header
^https:\/\/((?:(?:upos-(?:hz|sz|bstar1)-mirrorakam\.akamaized\.net|upos-sz-mirror[a-z0-9-]*(?:ov|bstar1)\.bilivideo\.com|cn-hk-eq-[a-z0-9-]+\.bilivideo\.com)(?::\d+)?|[^/]+:4480|[adbcefxy0-9]+\.mcdn\.bilivideo\.cn:(?:4483|9102)))\/(upgcxcode\/.*)$ https:\/\/\{{{endpoint}}}\/https\/$1\/$2 header

[MITM]
hostname = biliverse.github.io, %APPEND% biliverse.github.io, *.mcdn.bilivideo.cn, upos-sz-mirror*.bilivideo.com, cn-hk-eq-*.bilivideo.com, upos-*-mirrorakam.akamaized.net
